# Copy to .env.local for local development. In Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# --- Site -------------------------------------------------------------------
# Public base URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://loqelo.com
# Public contact address shown in the privacy policy (confirm with the client).
NEXT_PUBLIC_CONTACT_EMAIL=
# Legal name and address of the data controller (shown in the privacy policy).
NEXT_PUBLIC_CONTROLLER_DETAILS=

# --- Brevo (contacts / waitlist) — server-side only, never NEXT_PUBLIC_ -----
BREVO_API_KEY=
# List IDs printed by `npm run brevo:setup`
BREVO_LIST_ID_CUSTOMERS=
BREVO_LIST_ID_PROVIDERS=
# Optional double opt-in: Brevo DOI template ID and the page users land on after confirming.
BREVO_DOI_TEMPLATE_ID=
BREVO_DOI_REDIRECT_URL=

# --- Spam protection (Cloudflare Turnstile, free) ---------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (Google Analytics 4) -----------------------------------------
# Measurement ID, e.g. G-XXXXXXXXXX. Analytics stays off until it is set and the visitor consents.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
